{
  "name": "@webbuilder/frameworks",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-framework adapters for WebBuilder — Vue, Svelte, iOS (SwiftUI), Flutter",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.mjs",
      "require": "./dist/svelte/index.js",
      "types": "./dist/svelte/index.d.ts"
    },
    "./ios": {
      "import": "./dist/ios/index.mjs",
      "require": "./dist/ios/index.js",
      "types": "./dist/ios/index.d.ts"
    },
    "./flutter": {
      "import": "./dist/flutter/index.mjs",
      "require": "./dist/flutter/index.js",
      "types": "./dist/flutter/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/vue/index.ts src/svelte/index.ts src/ios/index.ts src/flutter/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@webbuilder/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "@types/node": "^20.0.0"
  }
}