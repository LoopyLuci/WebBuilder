{
  "name": "@webbuilder/mcp-server",
  "version": "1.0.0",
  "description": "WebBuilder MCP Server — AI agent integration for building web and Android apps",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "webbuilder-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@webbuilder/android": "workspace:*",
    "@webbuilder/core": "workspace:*",
    "commander": "^12.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "webbuilder",
    "mcp",
    "ai-agent",
    "web-builder",
    "code-generation",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LoopyLuci/WebBuilder",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/LoopyLuci/WebBuilder/issues"
  },
  "homepage": "https://github.com/LoopyLuci/WebBuilder#readme"
}
