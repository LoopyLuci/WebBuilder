{
  "name": "@webbuilder/server",
  "version": "1.0.0",
  "description": "WebBuilder Server — Local-first server for hosting WebBuilder projects",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "webbuilder-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "Dockerfile",
    "docker-compose.yml",
    "deploy"
  ],
  "scripts": {
    "build": "tsup src/server.ts src/cli.ts --format cjs,esm --dts",
    "dev": "tsup src/server.ts src/cli.ts --format cjs,esm --dts --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webbuilder/core": "workspace:*",
    "chokidar": "^3.5.0",
    "commander": "^12.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "webbuilder",
    "server",
    "local-first",
    "self-hosted"
  ]
}
